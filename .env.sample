# See https://docs.karakeep.app/configuration for more information
DATA_DIR=<path>
NEXTAUTH_SECRET=<secret>

# Database Configuration (optional - defaults to SQLite)
# For PostgreSQL support, uncomment and configure:
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/karakeep
# Or configure individual settings:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=karakeep
# DB_PASSWORD=password
# DB_NAME=karakeep